{
    "name": "synagogue-management",
    "bin": "index.js",
    "pkg": {
        "assets": [
            "views/**/*",
            "public/**/*"
        ],
        "targets": [
            "node18-win-x64"
        ]
    },
    "version": "1.4.26",
    "description": "Synagogue Management Application",
    "author": "Synagogue Management Team",
    "main": "electron.cjs",
    "type": "module",
    "scripts": {
        "dev": "concurrently \"node index.js\" \"vite\"",
        "build": "vite build",
        "preview": "vite preview",
        "start": "electron .",
        "dist": "npm run build && node scripts/prepare-dist.cjs && node scripts/build-installer.cjs && npm run postdist",
        "postdist": "node -e \"const fs = require('fs'); const path = require('path'); const pkg = require('./package.json'); const version = pkg.version; const outputDir = (pkg.build && pkg.build.directories && pkg.build.directories.output) || 'build-output'; const installer = path.join(outputDir, 'Nihul Beit Cnecet Setup ' + version + '.exe'); fs.copyFileSync(installer, path.join('dist', 'Nihul Beit Cnecet Setup ' + version + '.exe')); fs.copyFileSync(installer, path.join('.', 'Nihul Beit Cnecet Setup ' + version + '.exe'));\""
    },
    "dependencies": {
        "@hebcal/core": "^6.0.8",
        "antd": "^6.6.0",
        "dotenv": "^16.4.5",
        "express": "^5.2.1",
        "hebcal": "^2.3.2",
        "lucide-react": "^0.563.0",
        "mongodb": "^6.8.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^4.3.1",
        "concurrently": "^9.2.1",
        "electron": "^40.3.0",
        "electron-builder": "^26.15.3",
        "electron-packager": "^17.1.2",
        "esbuild": "^0.27.3",
        "vite": "^5.4.21"
    },
    "build": {
        "artifactName": "Nihul Beit Cnecet Setup ${version}.exe",
        "appId": "com.synagogue.management",
        "productName": "Nihul Beit Cnecet",
        "asar": false,
        "directories": {
            "output": "build-output-1.4.23"
        },
        "files": [
            "dist/**/*",
            "public/**/*",
            "index.js",
            "db.js",
            "accessControl.js",
            "electron.cjs",
            "package.json",
            "data/**/*",
            "prague_synagogue_icon.ico",
            "!**/node_modules/antd/**",
            "!**/node_modules/@ant-design/**",
            "!**/node_modules/react/**",
            "!**/node_modules/react-dom/**",
            "!**/node_modules/lucide-react/**"
        ],
        "win": {
            "target": "nsis",
            "icon": "prague_synagogue_icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "runAfterFinish": true
        }
    }
}
